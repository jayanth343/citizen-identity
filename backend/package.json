{
  "name": "fabric-backend",
  "version": "1.0.0",
  "description": "Backend service for Hyperledger Fabric integration",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "ts:dev": "npx nodemon --watch \"src/**\" --ext \"ts,json\" --exec \"npx ts-node --esm src/index.ts\"",
    "build": "tsc"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "fabric-ca-client": "^2.2.15",
    "fabric-network": "^2.2.15",
    "multer": "^1.4.5-lts.2",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.5",
    "@types/uuid": "^9.0.5",
    "nodemon": "^3.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
